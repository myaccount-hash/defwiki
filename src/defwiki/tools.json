[
  {
    "name": "rules",
    "description": "運用規則の全文を返す．Wikiに書き込む前に読む．",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "get",
    "description": "識別子で定義を取得し，識別子，用語，説明をdefsで同じ順に返す．存在しない識別子が1つでもあれば失敗する．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]{6}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "ids"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "defs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "term": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "term",
              "description"
            ]
          }
        }
      },
      "required": [
        "defs"
      ]
    }
  },
  {
    "name": "search",
    "description": "文字列ごとに，それを用語または説明に含む定義を探す．excerptは説明の抜粋であり，説明だけが一致した定義では一致の周辺を示す．作る予定の用語をまとめて渡せば，既存の定義との重複を1回で確かめられる．limitは文字列ごとの上限である．truncatedがtrueなら，該当がlimitを超えている．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "required": [
        "queries"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "hits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "term": {
                      "type": "string"
                    },
                    "excerpt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "term",
                    "excerpt"
                  ]
                }
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "query",
              "hits",
              "truncated"
            ]
          }
        }
      },
      "required": [
        "results"
      ]
    }
  },
  {
    "name": "longest",
    "description": "説明の長い順に定義を返す．長さは説明の文字数であり，参照は0文字と数える．保守で，他の定義に分散させる候補を探すのに用いる．説明はgetで取得する．truncatedがtrueなら，定義がlimitを超えている．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "defs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "term": {
                "type": "string"
              },
              "length": {
                "type": "integer"
              }
            },
            "required": [
              "id",
              "term",
              "length"
            ]
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "defs",
        "truncated"
      ]
    }
  },
  {
    "name": "references",
    "description": "識別子ごとに，その定義を参照している定義を返す．limitは識別子ごとの上限である．truncatedがtrueなら，該当がlimitを超えている．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]{6}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "required": [
        "ids"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "referrers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "term": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "term"
                  ]
                }
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "referrers",
              "truncated"
            ]
          }
        }
      },
      "required": [
        "results"
      ]
    }
  },
  {
    "name": "clusters",
    "description": "参照で結び付いた定義を，Louvain法でクラスタに分けて返す．参照の向きは問わず，自己参照は数えない．参照も被参照もない定義は含めない．クラスタは大きい順に並び，各クラスタの定義はクラスタ内で参照し合う定義の数の多い順に並ぶ．resolutionを大きくするとクラスタは細かくなる．保守で，分野のまとまりや分野をまたぐ定義を探すのに用いる．limitはクラスタごとの上限である．truncatedがtrueなら，定義がlimitを超えている．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "resolution": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10,
          "default": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "clusters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "size": {
                "type": "integer"
              },
              "defs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "term": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "term"
                  ]
                }
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "size",
              "defs",
              "truncated"
            ]
          }
        }
      },
      "required": [
        "clusters"
      ]
    }
  },
  {
    "name": "create",
    "description": "定義をまとめて作成し，割り当てた識別子と用語をdefsで同じ順に返す．同じ呼び出し内の用語は重複できない．既存の定義への参照は[[識別子|用語]]と書く．同じ呼び出しで作る定義は[[用語]]で参照できる．[[用語]]で既存の定義は検索しない．[[識別子|用語]]の形はIDによる参照として解釈する．循環参照する定義群は1回で作成する．1件でも違反があれば，どれも作成しない．警告はcheckで確認する．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "defs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "term",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "defs"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "defs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "term": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "term"
            ]
          }
        }
      },
      "required": [
        "defs"
      ]
    }
  },
  {
    "name": "update",
    "description": "定義の説明をまとめて書き換える．各要素は，descriptionで全文を置き換えるか，editsで一部を置き換える．editsは提示形式の説明に対し，oldをnewに先頭から順に置き換える．oldはその時点の説明にちょうど1回現れなければならない．1件でも失敗すれば何も変えない．説明中の参照は[[識別子|用語]]と書く．警告はcheckで確認する．成功時は空のオブジェクトを返す．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]{6}$"
              },
              "description": {
                "type": "string"
              },
              "edits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "old": {
                      "type": "string",
                      "minLength": 1
                    },
                    "new": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "old",
                    "new"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "updates"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "rename",
    "description": "定義の用語をまとめて変更する．1件でも失敗すれば何も変えない．成功時は空のオブジェクトを返す．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "renames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]{6}$"
              },
              "term": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "term"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "renames"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "delete",
    "description": "定義をまとめて削除する．削除する定義の外から参照されている定義は削除できない．1件でも失敗すれば何も削除しない．警告はcheckで確認する．成功時は空のオブジェクトを返す．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]{6}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "ids"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "merge",
    "description": "統合を順に施す．統合は定義idを定義intoに統合する．idへの参照を全てintoへの参照に置き換え，idを削除する．idの用語と説明は捨てる．1件でも失敗すれば何も変えない．警告はcheckで確認する．成功時は空のオブジェクトを返す．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "merges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]{6}$"
              },
              "into": {
                "type": "string",
                "pattern": "^[a-z0-9]{6}$"
              }
            },
            "required": [
              "id",
              "into"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "merges"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "check",
    "description": "Wiki全体を点検し，運用規則への違反の疑いを返す．isolatedは参照も被参照もない定義，duplicate_descriptionsは説明が同じ定義の組，externalは外部への参照を含む定義．limitは項目ごとの上限である．truncatedは項目ごとに該当がlimitを超えるかを，countsは項目ごとの全件数を示す．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "isolated": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "term": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "term"
            ]
          }
        },
        "duplicate_descriptions": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "term": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "term"
              ]
            }
          }
        },
        "external": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "term": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "term"
            ]
          }
        },
        "truncated": {
          "type": "object",
          "properties": {
            "isolated": {
              "type": "boolean"
            },
            "duplicate_descriptions": {
              "type": "boolean"
            },
            "external": {
              "type": "boolean"
            }
          },
          "required": [
            "isolated",
            "duplicate_descriptions",
            "external"
          ]
        },
        "counts": {
          "type": "object",
          "properties": {
            "isolated": {
              "type": "integer"
            },
            "duplicate_descriptions": {
              "type": "integer"
            },
            "external": {
              "type": "integer"
            }
          },
          "required": [
            "isolated",
            "duplicate_descriptions",
            "external"
          ]
        }
      },
      "required": [
        "isolated",
        "duplicate_descriptions",
        "external",
        "truncated",
        "counts"
      ]
    }
  },
  {
    "name": "todo_add",
    "description": "ToDoを受け取った順に並べて先頭に積み，割り当てた番号と本文をtodosで返す．作業中に気づいた別の問題を，失わないよう記録する．本文中の参照は[[識別子|用語]]と書く．1件でも違反があれば，どれも積まない．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "texts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "texts"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "todos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ]
          }
        }
      },
      "required": [
        "todos"
      ]
    }
  },
  {
    "name": "todo_list",
    "description": "ToDoを上から順に返す．truncatedがtrueなら，ToDoがlimitを超えている．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "todos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ]
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "todos",
        "truncated"
      ]
    }
  },
  {
    "name": "todo_remove",
    "description": "ToDoをまとめて消し，消した番号と本文をtodosで返す．終えたToDoは消す．存在しない番号が1つでもあれば，どれも消さない．",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "uniqueItems": true
